# Copia este archivo como ".env" solo si necesitas cambiar algo.

# Puerto en el que se abre la app (http://localhost:3210).
PORT=3210

# Carpeta donde se guarda la base de datos.
# DATA_DIR=./data

# --- Publicar en internet (manager.playctp.com y ruleta.playctp.com) ---
# Pon la app detrás de un proxy con HTTPS (nginx, Caddy, Cloudflare Tunnel…)
# que reenvíe los dos dominios a http://localhost:3210 conservando el Host.
# MANAGER_HOST=manager.playctp.com
# RULETA_HOST=ruleta.playctp.com
# Cookie compartida: una sola sesión para el manager y la ruleta.
# COOKIE_DOMAIN=playctp.com
# TRUST_PROXY=1

# Copia este archivo como ".env" solo si necesitas cambiar algo.

# Puerto en el que se abre la app (http://localhost:3210).
PORT=3210

# Carpeta donde se guarda la base de datos.
# DATA_DIR=./data

# VPS: crear primero el administrador desde localhost y después fijar el origen
# HTTPS exacto. Express sigue escuchando solo en 127.0.0.1/::1; usar proxy inverso.
# PUBLIC_ORIGIN=https://manager.playctp.com
# Puerto del frontend Vite autorizado solo en desarrollo local.
# DEV_WEB_PORT=5173

# Puente CTP: credenciales SOLO del servidor, nunca variables VITE_.
# Sin estas variables no se realizan peticiones externas.
# CTP_OPERATIONS_URL=https://PROJECT.supabase.co/functions/v1/manager-operations
# CTP_WEB_ORIGIN=https://playctp.com
# Para QA en este PC: CTP_WEB_ORIGIN=http://127.0.0.1:5181
# CTP_OPERATIONS_TOKEN=replace-with-a-random-token-of-at-least-32-characters
# CTP_SIGNING_SECRET=separate-random-signing-secret-at-least-32-characters
# Debe coincidir con MANAGER_SIGNING_SECRET en la función CTP; nunca en navegador.
# Firma HMAC, caducidad y nonce de un solo uso; Origin por sí solo no autentica.
# CTP_ALLOW_LOCAL_WRITES=false
# Solo pruebas aisladas loopback pueden habilitar esta excepción; nunca PRE/PRO.
# Las escrituras remotas exigen además binding y permisos del operador en CTP.
CTP_ENABLE_WRITES=false
# Sincronización de lectura opcional, 0=solo botón manual, mínimo 30 segundos.
CTP_SYNC_SECONDS=0

# Agente PC de realización. Token dedicado distinto del puente CTP.
# OBS_AGENT_TOKEN=replace-with-a-separate-random-token-of-at-least-32-characters
OBS_ENABLE_CONTROL=false

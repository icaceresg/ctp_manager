# Template only. Install private reviewed values at /etc/ctp-manager/prod.env.
# This file never contains real credentials and must not replace an active env.
NODE_ENV=production
PORT=3211
DATA_DIR=/var/lib/ctp-manager-prod
PUBLIC_ORIGIN=https://manager.playctp.com
CTP_AUTH_MODE=ctp
CTP_AUTH_URL=https://playctp.com
CTP_AUTH_ANON_KEY=replace-with-current-prod-public-anon-jwt
CTP_AUTH_TOKEN_KEY=replace-with-independent-32-random-bytes-in-base64url
CTP_WEB_ORIGIN=https://playctp.com
CTP_OPERATIONS_URL=https://playctp.com/functions/v1/manager-operations
CTP_OPERATIONS_TOKEN=replace-with-dedicated-server-only-bridge-token
CTP_SIGNING_SECRET=replace-with-independent-server-only-signing-secret
# Enable only after signed read/write acceptance and database preservation checks.
CTP_ENABLE_WRITES=false
CTP_ALLOW_LOCAL_WRITES=false
CTP_SYNC_SECONDS=0
OBS_ENABLE_CONTROL=false
OPEN_BROWSER=0

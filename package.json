{
  "name": "ctp-manager",
  "version": "1.0.0",
  "private": true,
  "description": "CTP Manager: intranet de Connect To Play para organizar el contenido de redes, escaletas y recursos.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "npm run build && npm run serve",
    "serve": "node --disable-warning=ExperimentalWarning server/index.js",
    "build": "vite build",
    "dev": "concurrently -k -n api,web -c blue,magenta \"node --watch --disable-warning=ExperimentalWarning server/index.js\" \"vite\"",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/*.test.js\"",
    "importar": "node --disable-warning=ExperimentalWarning scripts/import-excel.js",
    "nueva-contrasena": "node --disable-warning=ExperimentalWarning scripts/reset-password.js"
  },
  "dependencies": {
    "express": "^5.2.1"
  },
  "overrides": {
    "source-map-js": "1.2.2",
    "shell-quote": "1.12.0",
    "exceljs": { "uuid": "11.1.1" }
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/saira-condensed": "^5.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "simple-icons": "^16.32.0",
    "vite": "^8.3.1"
  }
}
